#!/usr/bin/env bash
# Лаунчер mp-docs: сам находит подходящий python.
# Для чтения (search/status/changelog/changes) хватает голого python3 —
# нужны только rg и git. Для обновления нужны requests и pyyaml, а браузерным
# источникам (Ozon, WB, инструкция Uzum) ещё и camoufox: он стоит в venv ozonpos,
# не в системном.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT="$HERE/scripts/mpdocs.py"

candidates=(
  "${MP_DOCS_PYTHON:-}"
  "$HERE/.venv/bin/python"
  "/root/.openclaw/workspace/ozonpos/.venv/bin/python"
  "python3"
)

for py in "${candidates[@]}"; do
  [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 || continue
  if "$py" -c 'import camoufox, requests, yaml' 2>/dev/null; then exec "$py" "$SCRIPT" "$@"; fi
done

for py in "${candidates[@]}"; do
  [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 || continue
  if "$py" -c 'import requests, yaml' 2>/dev/null; then
    echo "⚠️  python с camoufox не найден — Ozon, WB и инструкция Uzum качаться не будут." >&2
    exec "$py" "$SCRIPT" "$@"
  fi
done

# Ни requests, ни yaml: читать зеркало это не мешает, качать — да.
for py in "${candidates[@]}"; do
  [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 || continue
  if [ "${1:-}" = "update" ]; then
    echo "⛔ для update нужны requests и pyyaml — здесь их нет." >&2
    echo "   Обновляйтесь из общего зеркала: git -C \"$HERE/mirror\" pull" >&2
    exit 2
  fi
  exec "$py" "$SCRIPT" "$@"
done

echo "⛔ не найден python3" >&2
exit 2
